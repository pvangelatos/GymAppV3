@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- ── Authenticated: role-based dashboard cards ── -->
    <div class="d-flex align-items-center mb-1">
        <div>
            <h1 class="mb-0">Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 18 ? "afternoon" : "evening") 👋</h1>
            <p class="lead mb-0">What would you like to do today?</p>
        </div>
    </div>
    <hr class="mt-3 mb-4" />

    <div class="row g-3">
        @if (User.IsInRole(RoleConstants.Member))
        {
            <div class="col-md-4">
                <div class="card h-100 card-accent-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-speedometer2" style="font-size: 1.8rem; color: var(--gym-accent);"></i>
                        </div>
                        <h5 class="card-title">My Dashboard</h5>
                        <p class="card-text flex-grow-1">View your profile, bookings and active memberships.</p>
                        <a asp-page="/Members/Dashboard" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 card-success-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-calendar3" style="font-size: 1.8rem; color: var(--gym-success);"></i>
                        </div>
                        <h5 class="card-title">Class Schedule</h5>
                        <p class="card-text flex-grow-1">Browse upcoming fitness classes and reserve your spot.</p>
                        <a asp-page="/Classes/Schedule" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> View Schedule
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 card-warning-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-gem" style="font-size: 1.8rem; color: var(--gym-warning);"></i>
                        </div>
                        <h5 class="card-title">Membership Packages</h5>
                        <p class="card-text flex-grow-1">Explore available plans and purchase a membership.</p>
                        <a asp-page="/Memberships/Packages" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> Browse Packages
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole(RoleConstants.Trainer) || User.IsInRole(RoleConstants.TrainerAdmin) || User.IsInRole(RoleConstants.Admin))
        {
            <div class="col-md-4">
                <div class="card h-100 card-accent-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-people" style="font-size: 1.8rem; color: var(--gym-accent);"></i>
                        </div>
                        <h5 class="card-title">Manage Members</h5>
                        <p class="card-text flex-grow-1">Search, view and edit gym member profiles.</p>
                        <a asp-page="/Staff/Members/Index" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> Manage Members
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 card-success-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-collection-play" style="font-size: 1.8rem; color: var(--gym-success);"></i>
                        </div>
                        <h5 class="card-title">Manage Classes</h5>
                        <p class="card-text flex-grow-1">View, schedule and track class sessions.</p>
                        <a asp-page="/Staff/Classes/Index" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> Manage Classes
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 card-warning-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-journal-check" style="font-size: 1.8rem; color: var(--gym-warning);"></i>
                        </div>
                        <h5 class="card-title">View Bookings</h5>
                        <p class="card-text flex-grow-1">Review all class bookings across sessions.</p>
                        <a asp-page="/Staff/Bookings/Index" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> View Bookings
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.TrainerAdmin))
        {
            <div class="col-md-4">
                <div class="card h-100 card-danger-left">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <i class="bi bi-shield-lock" style="font-size: 1.8rem; color: var(--gym-danger);"></i>
                        </div>
                        <h5 class="card-title">Administration</h5>
                        <p class="card-text flex-grow-1">Manage facilities, trainers, packages and reports.</p>
                        <a asp-page="/Admin/Buildings/Index" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i> Admin Panel
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- ── Guest: Hero section ── -->
    <section class="gym-hero">
        <div class="gym-hero-content text-center">
            <p class="gym-hero-eyebrow">Welcome to</p>
            <h1 class="gym-hero-title">Gym Management<br />System</h1>
            <p class="gym-hero-sub">
                Book classes, track your memberships and manage your fitness journey —<br class="d-none d-md-block" />
                all in one place.
            </p>
            <div class="gym-hero-actions">
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg">
                    <i class="bi bi-person-plus me-2"></i>Join Now
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">
                    Sign In
                </a>
            </div>
        </div>
    </section>

    <!-- ── Feature highlights ── -->
    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card h-100 text-center gym-feature-card">
                <div class="card-body py-4">
                    <i class="bi bi-calendar-check gym-feature-icon"></i>
                    <h5 class="card-title mt-3">Book Classes</h5>
                    <p class="card-text">Browse the weekly schedule and reserve your spot in any fitness class with one click.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center gym-feature-card">
                <div class="card-body py-4">
                    <i class="bi bi-gem gym-feature-icon"></i>
                    <h5 class="card-title mt-3">Flexible Memberships</h5>
                    <p class="card-text">Choose a membership package that fits your goals — monthly, annual or session-based.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center gym-feature-card">
                <div class="card-body py-4">
                    <i class="bi bi-graph-up gym-feature-icon"></i>
                    <h5 class="card-title mt-3">Track Progress</h5>
                    <p class="card-text">Keep an eye on your bookings, sessions remaining and membership status from your dashboard.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ── CTA strip ── -->
    <div class="gym-cta-strip mt-4">
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div>
                <h5 class="mb-1" style="font-family: var(--gym-font-display);">Ready to start?</h5>
                <p class="mb-0 small" style="color: var(--gym-text-muted);">Create a free account and book your first class today.</p>
            </div>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary flex-shrink-0">
                <i class="bi bi-arrow-right me-1"></i> Get Started
            </a>
        </div>
    </div>
}
