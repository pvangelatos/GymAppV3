<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management System</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-trophy"></i> Gym Management
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index">Home</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Member Navigation -->
                            @if (User.IsInRole(RoleConstants.Member))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="memberDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        My Account
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="memberDropdown">
                                        <li><a class="dropdown-item" asp-page="/Members/Dashboard">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-page="/Members/Profile">My Profile</a></li>
                                        <li><a class="dropdown-item" asp-page="/Members/Bookings/Index">My Bookings</a></li>
                                        <li><a class="dropdown-item" asp-page="/Members/Memberships/Index">My Memberships</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="classesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Classes
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="classesDropdown">
                                        <li><a class="dropdown-item" asp-page="/Classes/Schedule">Class Schedule</a></li>
                                        <li><a class="dropdown-item" asp-page="/Classes/Book">Book a Class</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-page="/Memberships/Packages">Membership Packages</a>
                                </li>
                            }

                            <!-- Staff Navigation -->
                            @if (User.IsInRole(RoleConstants.Trainer) || User.IsInRole(RoleConstants.TrainerAdmin) || User.IsInRole(RoleConstants.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="staffDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Staff
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="staffDropdown">
                                        <li><a class="dropdown-item" asp-page="/Staff/Members/Index">Manage Members</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/Bookings/Index">View Bookings</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/Classes/Index">Manage Classes</a></li>
                                    </ul>
                                </li>
                            }

                            <!-- Admin Navigation -->
                            @if (User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.TrainerAdmin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Administration
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li><h6 class="dropdown-header">People</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Trainers/Index">Trainers</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Facilities</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Buildings/Index">Buildings</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Rooms/Index">Rooms</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Categories/Index">Class Categories</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Business</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/MembershipPackages/Index">Membership Packages</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Reports/Financial">Financial Reports</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Gym Management System - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
