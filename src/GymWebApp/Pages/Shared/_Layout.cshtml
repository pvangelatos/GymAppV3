@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="el" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitHub</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymWebApp.styles.css" asp-append-version="true" />
    <script>
        // Apply the saved sidebar state before first paint, so the sidebar doesn't flash wide.
        try { if (localStorage.getItem("fithub.sidebar.collapsed") === "1") document.documentElement.classList.add("fh-collapsed"); } catch (e) { }
    </script>
</head>
<body>
@if (signedIn)
{
    <div class="fh-shell" id="fhShell">
        <partial name="_Sidebar" />
        <div class="fh-main">
            <header class="fh-topbar d-md-none">
                <button type="button" class="btn fh-icon-btn" data-fh-toggle="mobile" aria-label="Μενού"><i class="bi bi-list"></i></button>
                <a class="fh-brand text-decoration-none" asp-area="" asp-page="/Index">Fit<span class="fh-brand-accent">Hub</span></a>
            </header>
            <main class="fh-content" role="main">
                <partial name="_StatusMessages" />
                @RenderBody()
            </main>
        </div>
        <div class="fh-backdrop" data-fh-toggle="mobile"></div>
    </div>
}
else
{
    <header class="fh-public-bar">
        <a class="fh-brand text-decoration-none" asp-area="" asp-page="/Index">Fit<span class="fh-brand-accent">Hub</span></a>   
        <partial name="_LoginPartial" />
    </header>
    <main class="fh-content" role="main">
        <partial name="_StatusMessages" />
        @RenderBody()
    </main>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/fithub.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>