<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management System</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-trophy-fill"></i> Gym Management
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Member Navigation -->
                            @if (User.IsInRole(RoleConstants.Member))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="memberDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        My Account
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="memberDropdown">
                                        <li><a class="dropdown-item" asp-page="/Members/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-page="/Members/Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                        <li><a class="dropdown-item" asp-page="/Members/Bookings/Index"><i class="bi bi-calendar-check me-2"></i>My Bookings</a></li>
                                        <li><a class="dropdown-item" asp-page="/Members/Memberships/Index"><i class="bi bi-card-checklist me-2"></i>My Memberships</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="classesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Classes
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="classesDropdown">
                                        <li><a class="dropdown-item" asp-page="/Classes/Schedule"><i class="bi bi-calendar3 me-2"></i>Class Schedule</a></li>
                                        <li><a class="dropdown-item" asp-page="/Classes/Book"><i class="bi bi-plus-circle me-2"></i>Book a Class</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Memberships/Packages">Membership Packages</a>
                                </li>
                            }

                            <!-- Staff Navigation -->
                            @if (User.IsInRole(RoleConstants.Trainer) || User.IsInRole(RoleConstants.TrainerAdmin) || User.IsInRole(RoleConstants.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="staffDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Staff
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="staffDropdown">
                                        <li><a class="dropdown-item" asp-page="/Staff/Members/Index"><i class="bi bi-people me-2"></i>Manage Members</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/Bookings/Index"><i class="bi bi-journal-check me-2"></i>View Bookings</a></li>
                                        <li><a class="dropdown-item" asp-page="/Staff/Classes/Index"><i class="bi bi-collection-play me-2"></i>Manage Classes</a></li>
                                    </ul>
                                </li>
                            }

                            <!-- Admin Navigation -->
                            @if (User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.TrainerAdmin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Administration
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li><h6 class="dropdown-header">People</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Trainers/Index"><i class="bi bi-person-badge me-2"></i>Trainers</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Facilities</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Buildings/Index"><i class="bi bi-building me-2"></i>Buildings</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Rooms/Index"><i class="bi bi-door-open me-2"></i>Rooms</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/ClassCategories/Index"><i class="bi bi-tags me-2"></i>Class Categories</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Business</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/MembershipPackages/Index"><i class="bi bi-gem me-2"></i>Membership Packages</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Reports/Finance"><i class="bi bi-bar-chart-line me-2"></i>Financial Reports</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            <div class="row py-3">
                <div class="col-md-4">
                    <span class="fw-medium" style="font-family: var(--gym-font-display);">
                        <i class="bi bi-trophy-fill me-1"></i> Gym Management
                    </span>
                    <p class="small mt-1 mb-0" style="color: var(--gym-text-muted);">Your complete fitness center solution.</p>
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <p class="small fw-medium mb-1" style="color: var(--gym-text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-size: 11px;">Quick Links</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><a asp-area="" asp-page="/Index">Home</a></li>
                        <li><a asp-page="/Classes/Schedule">Class Schedule</a></li>
                        <li><a asp-page="/Memberships/Packages">Membership Packages</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <p class="small fw-medium mb-1" style="color: var(--gym-text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-size: 11px;">Legal</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><a asp-area="" asp-page="/Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-0">
            <p class="small py-2 mb-0" style="color: var(--gym-text-muted);">&copy; 2026 Gym Management System</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>