@page
@model CreateModel
@{
    ViewData["Title"] = "Create Room";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Administration", null),
        ("Rooms", "/Admin/Rooms/Index"),
        ("Create", null)
    };
}

<partial name="_Breadcrumbs" />
<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.ClassRoomName" class="form-label"></label>
                    <input asp-for="Input.ClassRoomName" class="form-control" />
                    <span asp-validation-for="Input.ClassRoomName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Capacity" class="form-label"></label>
                        <input asp-for="Input.Capacity" type="number" class="form-control" />
                        <span asp-validation-for="Input.Capacity" class="text-danger"></span>
                        <div class="form-text">Maximum number of people</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.GymBuildingId" class="form-label"></label>
                        <select asp-for="Input.GymBuildingId" asp-items="Model.Buildings" class="form-select">
                            <option value="">-- Select Building --</option>
                        </select>
                        <span asp-validation-for="Input.GymBuildingId" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Room</button>
                    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
