@page
@model IndexModel
@{
    ViewData["Title"] = "Manage Buildings";
}

<h1>@ViewData["Title"]</h1>
<p class="lead">Manage gym buildings and locations</p>
<hr />

<a asp-page="Create" class="btn btn-primary mb-3">Add New Building</a>

@if (Model.Buildings.Count > 0)
{
    <div class="row">
        @foreach (var building in Model.Buildings)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">@building.Name</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Address:</strong></p>
                        <address class="mb-0">
                            @building.Address.Street<br />
                            @building.Address.City, @building.Address.State @building.Address.ZipCode<br />
                            @building.Address.Country
                        </address>
                    </div>
                    <div class="card-footer">
                        <a asp-page="Edit" asp-route-id="@building.Id" class="btn btn-sm btn-primary">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteBuildingModal"
                                data-building-id="@building.Id" data-building-name="@building.Name">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No buildings found.</div>
}

<div class="modal fade" id="deleteBuildingModal" tabindex="-1" aria-labelledby="deleteBuildingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteBuildingModalLabel">Delete Building</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong id="deleteBuildingName"></strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                    <input type="hidden" name="id" id="deleteBuildingId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Building</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteBuildingModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteBuildingId').value = button.getAttribute('data-building-id');
            document.getElementById('deleteBuildingName').textContent = button.getAttribute('data-building-name');
        });
    </script>
}