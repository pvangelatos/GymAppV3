@page
@model IndexModel
@{
    ViewData["Title"] = "Manage Membership Packages";
}

<h1>@ViewData["Title"]</h1>
<p class="lead">Manage membership packages and pricing</p>
<hr />

<a asp-page="Create" class="btn btn-primary mb-3">Create New Package</a>

@if (Model.Packages.Count > 0)
{
    <div class="row">
        @foreach (var package in Model.Packages)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">@package.Name</h5>
                    </div>
                    <div class="card-body">
                        <h3 class="text-primary">@package.Price.ToString("C")</h3>
                        <ul class="list-unstyled">
                            <li><strong>Duration:</strong> @package.DurationInDays days</li>
                            <li><strong>Sessions:</strong> @package.SessionsIncluded</li>
                            <li><strong>Per Session:</strong> @((package.Price / package.SessionsIncluded).ToString("C"))</li>
                            <li><strong>Category:</strong> @package.ClassCategoryName</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a asp-page="Edit" asp-route-id="@package.Id" class="btn btn-sm btn-primary">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deletePackageModal"
                                data-package-id="@package.Id" data-package-name="@package.Name">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No membership packages found.</div>
}

<div class="modal fade" id="deletePackageModal" tabindex="-1" aria-labelledby="deletePackageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deletePackageModalLabel">Delete Membership Package</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong id="deletePackageName"></strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                    <input type="hidden" name="id" id="deletePackageId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Package</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deletePackageModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deletePackageId').value = button.getAttribute('data-package-id');
            document.getElementById('deletePackageName').textContent = button.getAttribute('data-package-name');
        });
    </script>
}