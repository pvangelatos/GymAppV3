@page
@model CreateModel
@{
    ViewData["Title"] = "Create Membership Package";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Administration", null),
        ("Membership Packages", "/Admin/MembershipPackages/Index"),
        ("Create", null)
    };
}

<partial name="_Breadcrumbs" />
<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Price" class="form-label"></label>
                    <input asp-for="Input.Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Input.DurationInDays" class="form-label"></label>
                    <input asp-for="Input.DurationInDays" type="number" class="form-control" />
                    <span asp-validation-for="Input.DurationInDays" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.SessionsIncluded" class="form-label"></label>
                    <input asp-for="Input.SessionsIncluded" type="number" class="form-control" />
                    <span asp-validation-for="Input.SessionsIncluded" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Input.ClassCategoryId" class="form-label"></label>
                    <select asp-for="Input.ClassCategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="Input.ClassCategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Package</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
