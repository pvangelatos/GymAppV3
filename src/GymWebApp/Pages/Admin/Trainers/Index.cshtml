@page
@model IndexModel
@{
    ViewData["Title"] = "Manage Trainers";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Administration", null),
        ("Trainers", null)
    };
}

<partial name="_Breadcrumbs" />
<h1>@ViewData["Title"]</h1>
<p class="lead">Manage gym trainers</p>
<hr />

<a asp-page="Create" class="btn btn-primary mb-3">Add New Trainer</a>

@if (Model.Trainers.Items.Count > 0)
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Specialties</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var trainer in Model.Trainers.Items)
            {
                <tr>
                    <td>@trainer.Firstname @trainer.Lastname</td>
                    <td>@trainer.Email</td>
                    <td>@(trainer.Phone ?? "N/A")</td>
                    <td>@string.Join(", ", trainer.Specialties.Select(s => s.ClassCategoryName))</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@trainer.Id" class="btn btn-sm btn-info">View</a>
                        <a asp-page="Edit" asp-route-id="@trainer.Id" class="btn btn-sm btn-primary">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteTrainerModal"
                                data-trainer-id="@trainer.Id" data-trainer-name="@trainer.Firstname @trainer.Lastname">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @if (Model.Trainers.Count > 0 && (Model.CurrentPage > 1 || Model.Trainers.Items.Count == Model.PageSize))
    {
        <nav aria-label="Trainers pagination">
            <ul class="pagination justify-content-center">
                @{
                    var totalPages = Model.Trainers.TotalPages > 0
                        ? Model.Trainers.TotalPages
                        : (int)Math.Ceiling((double)Model.Trainers.Count / Model.PageSize);

                    var hasPrevious = Model.CurrentPage > 1;

                    var hasNext = totalPages > 0
                        ? Model.CurrentPage < totalPages
                        : Model.Trainers.Items.Count == Model.PageSize;
                }

                <li class="page-item @(!hasPrevious ? "disabled" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.CurrentPage - 1)">Previous</a>
                </li>

                @if (totalPages > 0)
                {
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-pageIndex="@p">@p</a>
                        </li>
                    }
                }
                else
                {
                    <li class="page-item active">
                        <span class="page-link">@Model.CurrentPage</span>
                    </li>
                }

                <li class="page-item @(!hasNext ? "disabled" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>

        <p class="text-muted">
            Showing @Model.Trainers.Items.Count of @Model.Trainers.Count total trainer(s)
        </p>
    }
}
else
{
    <div class="alert alert-info">No trainers found.</div>
}

<div class="modal fade" id="deleteTrainerModal" tabindex="-1" aria-labelledby="deleteTrainerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteTrainerModalLabel">Delete Trainer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong id="deleteTrainerName"></strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                    <input type="hidden" name="id" id="deleteTrainerId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Trainer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteTrainerModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteTrainerId').value = button.getAttribute('data-trainer-id');
            document.getElementById('deleteTrainerName').textContent = button.getAttribute('data-trainer-name');
        });
    </script>
}