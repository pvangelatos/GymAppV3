@page
@model CreateModel
@{
    ViewData["Title"] = "Assign Membership";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Staff", null),
        ("Members", "/Staff/Members/Index"),
        (Model.Member?.Firstname + " " + Model.Member?.Lastname, $"/Staff/Members/Details/{Model.MemberId}"),
        ("Assign Membership", null)
    };
}

@using GymAppV3.Core.Enums;

<partial name="_Breadcrumbs" />
<h1>@ViewData["Title"]</h1>
<p class="lead">
    Member: <strong>@Model.Member?.Firstname @Model.Member?.Lastname</strong>
</p>
<hr />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Availability.Any(a => a.AvailableSlots == 0))
{
    <div class="alert alert-warning">
        <strong>Heads up:</strong> some packages below are at full capacity for their category this week and cannot be assigned.
    </div>
}

<table class="table table-sm">
    <thead>
        <tr>
            <th>Package</th>
            <th>Category</th>
            <th>Available slots</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model.Availability)
        {
            <tr class="@(a.AvailableSlots == 0 ? "table-danger" : "")">
                <td>@a.MembershipPackageName</td>
                <td>@a.ClassCategoryName</td>
                <td>@(a.AvailableSlots == 0 ? "Full" : a.AvailableSlots.ToString())</td>
            </tr>
        }
    </tbody>
</table>

<form method="post" class="col-md-6">
    <input type="hidden" asp-for="MemberId" />

    <div class="mb-3">
        <label asp-for="MembershipPackageId" class="form-label">Package</label>
        <select asp-for="MembershipPackageId" asp-items="Model.Packages" class="form-select">
            <option value="">-- Select package --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Method" class="form-label">Payment Method</label>
        <select asp-for="Method" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
    </div>
    <button type="submit" class="btn btn-primary">Assign Membership </button>
    <a asp-page="/Staff/Members/Details" asp-route-id="@Model.MemberId" class="btn btn-secondary">Cancel</a>
</form>