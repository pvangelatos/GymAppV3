@page
@model IndexModel
@{
    ViewData["Title"] = "Manage Classes";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Staff", null),
        ("Classes", null)
    };
}

<partial name="_Breadcrumbs" />

<div class="d-flex justify-content-between align-items-start mb-1">
    <div>
        <h1 class="mb-0">Class Sessions</h1>
        <p class="lead mb-0">View and schedule fitness classes</p>
    </div>
    <a asp-page="/Staff/Classes/Schedule" class="btn btn-primary btn-sm mt-1">
        <i class="bi bi-plus-circle me-1"></i> Schedule New Class
    </a>
</div>
<hr class="mt-3 mb-4" />

<!-- Filter bar -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label asp-for="FromDate" class="form-label">From</label>
                <input asp-for="FromDate" class="form-control form-control-sm" type="date" />
            </div>
            <div class="col-md-3">
                <label asp-for="ToDate" class="form-label">To</label>
                <input asp-for="ToDate" class="form-control form-control-sm" type="date" />
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-page="/Staff/Classes/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle me-1"></i> Clear
                </a>
            </div>
            @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
            {
                <div class="col-auto d-flex align-items-end">
                    <span class="badge bg-primary py-2">
                        <i class="bi bi-funnel-fill me-1"></i> Filtered
                    </span>
                </div>
            }
        </form>
    </div>
</div>

@if (Model.ClassSessions.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date &amp; Time</th>
                    <th>Duration</th>
                    <th>Trainer</th>
                    <th>Room</th>
                    <th>Seats</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.ClassSessions)
                {
                    var isPast = session.StartsAt < DateTimeOffset.UtcNow;
                    var isFull = session.AvailableSeats == 0;
                    <tr class="@(isPast ? "gym-row-past" : "")">
                        <td>
                            <span style="font-weight: 500;">@session.Title</span>
                            @if (isPast)
                            {
                                <span class="badge bg-secondary ms-1">Past</span>
                            }
                        </td>
                        <td style="color: var(--gym-text-muted); font-size: 13px;">@session.ClassCategoryName</td>
                        <td>
                            <span style="font-size: 13px;">@session.StartsAt.LocalDateTime.ToString("MMM dd, yyyy")</span><br />
                            <small style="color: var(--gym-text-muted);">@session.StartsAt.LocalDateTime.ToString("h:mm tt")</small>
                        </td>
                        <td style="color: var(--gym-text-muted); font-size: 13px;">@session.DurationInMinutes min</td>
                        <td style="font-size: 13px;">@session.TrainerName</td>
                        <td style="font-size: 13px;">@session.ClassRoomName</td>
                        <td>
                            <span class="badge @(isFull ? "bg-danger" : session.AvailableSeats <= 5 ? "bg-warning" : "bg-success")">
                                @session.AvailableSeats / @session.Capacity
                            </span>
                        </td>
                        <td>
                            <a asp-page="/Staff/Classes/Details" asp-route-id="@session.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="small mt-2 mb-0" style="color: var(--gym-text-muted);">
        <i class="bi bi-list-ul me-1"></i>
        Showing @Model.ClassSessions.Count session(s)
        @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
        {
            <span>in selected date range</span>
        }
    </p>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-calendar-x me-2"></i>
        <strong>No sessions found.</strong>
        @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
        {
            <span>Try adjusting the date range filter.</span>
        }
        else
        {
            <span>Schedule a new class to get started.</span>
        }
    </div>
}
