@page
@model IndexModel
@{
    ViewData["Title"] = "Manage Classes";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Staff", null),
        ("Classes", null)
    };
}

<partial name="_Breadcrumbs" />

<div class="d-flex justify-content-between align-items-start mb-1">
    <div>
        <h1 class="mb-0">@ViewData["Title"]</h1>
        <p class="lead mb-0">View the schedule and add members to classes</p>
    </div>
    <a asp-page="/Staff/Classes/Schedule" class="btn btn-primary btn-sm mt-1">
        <i class="bi bi-plus-circle me-1"></i> Schedule New Class
    </a>
</div>
<hr class="mt-3 mb-4" />

<div class="d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-outline-primary btn-sm" id="duplicateWeekBtn">
        <i class="bi bi-copy"></i> Duplicate this week
    </button>
</div>

<div id="classesCalendar"></div>

<!-- Modal: class session details + member adding -->
<div class="modal fade" id="sessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sessionModalTitle">Class session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1"><i class="bi bi-person"></i> <span id="sessionTrainer"></span></p>
                <p class="mb-1"><i class="bi bi-geo-alt"></i> <span id="sessionRoom"></span></p>
                <p class="mb-3">
                    <span class="badge bg-secondary" id="sessionCapacity"></span>
                </p>
                <hr />
                <label class="form-label">Προσθήκη μέλους</label>
                <input type="text" id="memberSearch" class="form-control mb-2" placeholder="Search with name or email..." autocomplete="off" />
                <ul class="list-group" id="candidateResults"></ul>
                <div id="bookingError" class="text-danger small mt-2"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Duplicate a week-->
<div class="modal fade" id="duplicateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Duplicate week</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Into how many upcoming weeks?</label>
                <input type="number" id="duplicateWeeksInput" class="form-control" min="1" max="52" value="1" />
                <div id="duplicateError" class="text-danger small mt-2" style="white-space: pre-line;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmDuplicateBtn">Copy</button>
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const calendarEl = document.getElementById('classesCalendar');
        const sessionModal = new bootstrap.Modal(document.getElementById('sessionModal'));
        const duplicateModal = new bootstrap.Modal(document.getElementById('duplicateModal'));
        const searchInput = document.getElementById('memberSearch');
        const resultsList = document.getElementById('candidateResults');
        const errorBox = document.getElementById('bookingError');
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        let currentSessionId = null;
        let currentClassCategoryId = null;
        let searchDebounce = null;

        const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'timeGridWeek',
        locale: 'el',
        titleFormat: { day: 'numeric', month: 'long', year: 'numeric' },
        dayHeaderFormat: { weekday: 'short', day: 'numeric', month: 'numeric' },
        headerToolbar: { left: 'prev,next today', center: 'title', right: 'timeGridWeek' },
        events: { url: '?handler=Events', method: 'GET' },
        eventClick: function (info) {
        currentSessionId = info.event.id;
        currentClassCategoryId = info.event.extendedProps.classCategoryId;

        document.getElementById('sessionModalTitle').textContent = info.event.title;
        document.getElementById('sessionTrainer').textContent = info.event.extendedProps.trainerName;
        document.getElementById('sessionRoom').textContent = info.event.extendedProps.roomName;
        document.getElementById('sessionCapacity').textContent =
        `${info.event.extendedProps.availableSeats} / ${info.event.extendedProps.capacity} available seats`;

        searchInput.value = '';
        resultsList.innerHTML = '';
        errorBox.textContent = '';
        sessionModal.show();
        }
        });
        calendar.render();

        // --- Search-as-you-type members for booking ---
        searchInput.addEventListener('input', function () {
        clearTimeout(searchDebounce);
        const term = searchInput.value.trim();
        if (term.length < 2) { resultsList.innerHTML = ''; return; }

        searchDebounce = setTimeout(async function () {
        const res = await fetch(`?handler=BookingCandidates&classCategoryId=${currentClassCategoryId}&term=${encodeURIComponent(term)}`);
        const candidates = await res.json();
        renderCandidates(candidates);
        }, 300);
        });

        function renderCandidates(candidates) {
        resultsList.innerHTML = '';
        if (candidates.length === 0) {
        resultsList.innerHTML = '<li class="list-group-item text-muted">No results</li>';
        return;
        }
        candidates.forEach(function (c) {
        const li = document.createElement('li');
        li.className = 'list-group-item d-flex justify-content-between align-items-center';
        if (!c.canBook) {
        li.classList.add('text-muted');
        li.innerHTML = `<span>${c.fullName}</span><small>${c.reason}</small>`;
        } else {
        li.style.cursor = 'pointer';
        li.innerHTML = `<span>${c.fullName}</span><i class="bi bi-plus-circle text-success"></i>`;
        li.addEventListener('click', () => addBooking(c.memberId));
        }
        resultsList.appendChild(li);
        });
        }

        async function addBooking(memberId) {
        errorBox.textContent = '';
        const res = await fetch(`?handler=AddBooking&memberId=${memberId}&classSessionId=${currentSessionId}`, {
        method: 'POST',
        headers: { 'RequestVerificationToken': antiForgeryToken }
        });
        const result = await res.json();
        if (result.success) {
        sessionModal.hide();
        calendar.refetchEvents();
        } else {
        errorBox.textContent = result.message || 'Something went wrong.';
        }
        }

        // --- Duplicate of a week ---
        document.getElementById('duplicateWeekBtn').addEventListener('click', function () {
        document.getElementById('duplicateError').textContent = '';
        duplicateModal.show();
        });

        document.getElementById('confirmDuplicateBtn').addEventListener('click', async function () {
        const repeatWeeks = document.getElementById('duplicateWeeksInput').value;
        const weekStart = calendar.view.activeStart.toISOString();
        const weekEnd = calendar.view.activeEnd.toISOString();

        const res = await fetch(`?handler=DuplicateWeek&weekStart=${weekStart}&weekEnd=${weekEnd}&repeatWeeks=${repeatWeeks}`, {
        method: 'POST',
        headers: { 'RequestVerificationToken': antiForgeryToken }
        });
        const result = await res.json();

        if (result.success) {
        duplicateModal.hide();
        calendar.refetchEvents();
        } else {
        document.getElementById('duplicateError').textContent = result.message || 'Something went wrong.';
        }
        });
        });
    </script>
}