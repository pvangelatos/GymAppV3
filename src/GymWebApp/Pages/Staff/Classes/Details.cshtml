@page
@model DetailsModel
@{
    ViewData["Title"] = "Class Session Details";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Staff", null),
        ("Classes", "/Staff/Classes/Index"),
        (Model.ClassSession?.Title ?? "Details", null)
    };
}

<partial name="_Breadcrumbs" />

@if (Model.ClassSession != null)
{
    <div class="d-flex justify-content-between align-items-start mb-1">
        <div>
            <h1 class="mb-0">@Model.ClassSession.Title</h1>
            <p class="lead mb-0">@Model.ClassSession.ClassCategoryName</p>
        </div>
        <a asp-page="/Staff/Classes/Index" class="btn btn-outline-secondary btn-sm mt-1">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
    <hr class="mt-3 mb-4" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100 card-accent-left">
                <div class="card-header">
                    <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                        <i class="bi bi-calendar3 me-2" style="color: var(--gym-accent);"></i>Schedule Information
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0" style="font-size: 14px;">
                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Date</dt>
                        <dd class="col-sm-8 mb-2">@Model.ClassSession.StartsAt.LocalDateTime.ToString("dddd, MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Time</dt>
                        <dd class="col-sm-8 mb-2">
                            @Model.ClassSession.StartsAt.LocalDateTime.ToString("h:mm tt") –
                            @Model.ClassSession.StartsAt.AddMinutes(Model.ClassSession.DurationInMinutes).LocalDateTime.ToString("h:mm tt")
                        </dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Duration</dt>
                        <dd class="col-sm-8 mb-2">@Model.ClassSession.DurationInMinutes minutes</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Trainer</dt>
                        <dd class="col-sm-8 mb-2">@Model.ClassSession.TrainerName</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Room</dt>
                        <dd class="col-sm-8 mb-0">@Model.ClassSession.ClassRoomName</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100 card-success-left">
                <div class="card-header">
                    <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                        <i class="bi bi-people me-2" style="color: var(--gym-success);"></i>Capacity &amp; Bookings
                    </h6>
                </div>
                <div class="card-body">
                    @{
                        var booked = Model.ClassSession.Capacity - Model.ClassSession.AvailableSeats;
                        var occupancy = (booked * 100.0 / Model.ClassSession.Capacity);
                    }

                    <dl class="row mb-3" style="font-size: 14px;">
                        <dt class="col-sm-6" style="color: var(--gym-text-muted); font-weight: 400;">Total Capacity</dt>
                        <dd class="col-sm-6 mb-2">@Model.ClassSession.Capacity people</dd>

                        <dt class="col-sm-6" style="color: var(--gym-text-muted); font-weight: 400;">Booked</dt>
                        <dd class="col-sm-6 mb-2">@booked</dd>

                        <dt class="col-sm-6" style="color: var(--gym-text-muted); font-weight: 400;">Available</dt>
                        <dd class="col-sm-6 mb-2">
                            <span class="badge @(Model.ClassSession.AvailableSeats > 5 ? "bg-success" : Model.ClassSession.AvailableSeats > 0 ? "bg-warning" : "bg-danger")">
                                @Model.ClassSession.AvailableSeats seats
                            </span>
                        </dd>

                        <dt class="col-sm-6" style="color: var(--gym-text-muted); font-weight: 400;">Occupancy</dt>
                        <dd class="col-sm-6 mb-0">@occupancy.ToString("F1")%</dd>
                    </dl>

                    <!-- Occupancy progress bar -->
                    <div class="progress mb-3" style="height: 6px; background-color: var(--gym-bg-hover); border-radius: 3px;">
                        <div class="progress-bar @(occupancy >= 100 ? "bg-danger" : occupancy >= 80 ? "bg-warning" : "bg-success")"
                             role="progressbar"
                             style="width: @occupancy.ToString("F0")%; background-color: @(occupancy >= 100 ? "var(--gym-danger)" : occupancy >= 80 ? "var(--gym-warning)" : "var(--gym-success)") !important;"
                             aria-valuenow="@occupancy.ToString("F0")"
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>

                    @if (Model.ClassSession.AvailableSeats == 0)
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Fully Booked</strong> — Maximum capacity reached.
                        </div>
                    }
                    else if (Model.ClassSession.AvailableSeats <= 5)
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <strong>Almost Full</strong> — Only @Model.ClassSession.AvailableSeats seat(s) remaining.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i> Class session not found.
    </div>
}
