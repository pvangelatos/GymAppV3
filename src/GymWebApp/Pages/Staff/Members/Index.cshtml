@page
@model IndexModel
@{
    ViewData["Title"] = "Manage Members";
}

<div class="row">
    <div class="col-md-12">
        <h1>@ViewData["Title"]</h1>
        <p class="lead">View and manage gym members</p>
        <hr />
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-page="/Staff/Members/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Member
        </a>
    </div>
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input asp-for="SearchTerm" class="form-control me-2" placeholder="Search members by name or email..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-page="/Staff/Members/Index" class="btn btn-outline-danger ms-2">Clear</a>
            }
        </form>
    </div>
</div>

@if (Model.Members.Items.Count > 0)
{
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>City</th>
                            <th>Birth Date</th>
                            <th>Medical</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members.Items)
                        {
                            <tr>
                                <td><strong>@member.Firstname @member.Lastname</strong></td>
                                <td>@member.Email</td>
                                <td>@(member.Phone ?? "N/A")</td>
                                <td>@member.Address.City</td>
                                <td>@member.BirthDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (member.HasMedicalConditions)
                                    {
                                        <span class="badge bg-warning text-dark">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No</span>
                                    }
                                </td>
                                <td>
                                    <a asp-page="/Staff/Members/Details" asp-route-id="@member.Id" class="btn btn-sm btn-info">
                                        View
                                    </a>
                                    <a asp-page="/Staff/Members/Edit" asp-route-id="@member.Id" class="btn btn-sm btn-primary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Members.Count > 0 && (Model.CurrentPage > 1 || Model.Members.Items.Count == Model.PageSize))
    {
        <div class="row mt-3">
            <div class="col-md-12">
                <nav aria-label="Members pagination">
                    <ul class="pagination justify-content-center">
                        @{
                            // Αν το TotalPages από το backend είναι 0, υπολογίζουμε ασφαλώς τα pages
                            var totalPages = Model.Members.TotalPages > 0
                                ? Model.Members.TotalPages
                                : (int)Math.Ceiling((double)Model.Members.Count / Model.PageSize);

                            var hasPrevious = Model.CurrentPage > 1;

                            // Έχει Next είτε αν δεν φτάσαμε στο totalPages, είτε αν η τρέχουσα σελίδα γεμίζει πλήρως το PageSize
                            var hasNext = totalPages > 0
                                ? Model.CurrentPage < totalPages
                                : Model.Members.Items.Count == Model.PageSize;
                        }

                        <!-- Previous Button -->
                        <li class="page-item @(!hasPrevious ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Staff/Members/Index"
                               asp-route-pageIndex="@(Model.CurrentPage - 1)"
                               asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                        </li>

                        <!-- Page Numbers -->
                        @if (totalPages > 0)
                        {
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="/Staff/Members/Index"
                                       asp-route-pageIndex="@p"
                                       asp-route-searchTerm="@Model.SearchTerm">@p</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="page-item active">
                                <span class="page-link">@Model.CurrentPage</span>
                            </li>
                        }

                        <!-- Next Button -->
                        <li class="page-item @(!hasNext ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Staff/Members/Index"
                               asp-route-pageIndex="@(Model.CurrentPage + 1)"
                               asp-route-searchTerm="@Model.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <p class="text-muted">
                Showing @Model.Members.Items.Count of @Model.Members.Count total member(s)
            </p>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                No members found.
            </div>
        </div>
    </div>
}
