@page
@model DetailsModel
@{
    ViewData["Title"] = "Member Details";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Staff", null),
        ("Members", "/Staff/Members/Index"),
        (Model.Member != null ? $"{Model.Member.Firstname} {Model.Member.Lastname}" : "Details", null)
    };
}

<partial name="_Breadcrumbs" />

@if (Model.Member != null)
{
    <div class="d-flex justify-content-between align-items-start mb-1">
        <div>
            <h1 class="mb-0">@Model.Member.Firstname @Model.Member.Lastname</h1>
            <p class="lead mb-0">Member Profile</p>
        </div>
        <div class="d-flex gap-2 mt-1">
            <a asp-page="/Staff/Members/Edit" asp-route-id="@Model.Member.Id" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Member
            </a>
            <a asp-page="/Staff/Members/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>
    <hr class="mt-3 mb-4" />

    <div class="row">
        <!-- Personal Information -->
        <div class="col-md-6 mb-3">
            <div class="card h-100 card-accent-left">
                <div class="card-header">
                    <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                        <i class="bi bi-person me-2" style="color: var(--gym-accent);"></i>Personal Information
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0" style="font-size: 14px;">
                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Name</dt>
                        <dd class="col-sm-8 mb-2">@Model.Member.Firstname @Model.Member.Lastname</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Email</dt>
                        <dd class="col-sm-8 mb-2">@Model.Member.Email</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Phone</dt>
                        <dd class="col-sm-8 mb-2">@(Model.Member.Phone ?? "—")</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Birth Date</dt>
                        <dd class="col-sm-8 mb-2">@Model.Member.BirthDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">Age</dt>
                        <dd class="col-sm-8 mb-2">@(DateTime.Today.Year - Model.Member.BirthDate.Year) years old</dd>

                        @if (!string.IsNullOrEmpty(Model.Member.UserId))
                        {
                            <dt class="col-sm-4" style="color: var(--gym-text-muted); font-weight: 400;">User ID</dt>
                            <dd class="col-sm-8 mb-0"><small style="color: var(--gym-text-muted);">@Model.Member.UserId</small></dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Address -->
        <div class="col-md-6 mb-3">
            <div class="card h-100 card-success-left">
                <div class="card-header">
                    <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                        <i class="bi bi-geo-alt me-2" style="color: var(--gym-success);"></i>Address
                    </h6>
                </div>
                <div class="card-body">
                    <address class="mb-0" style="font-size: 14px; line-height: 1.8;">
                        @Model.Member.Address.Street<br />
                        @Model.Member.Address.City, @Model.Member.Address.State @Model.Member.Address.ZipCode<br />
                        @Model.Member.Address.Country
                    </address>
                </div>
            </div>
        </div>
    </div>

    <!-- Health Information -->
    <div class="row">
        <div class="col-md-12 mb-3">
            <div class="card @(Model.Member.HasMedicalConditions ? "card-warning-left" : "card-success-left")">
                <div class="card-header">
                    <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                        <i class="bi bi-heart-pulse me-2" style="color: @(Model.Member.HasMedicalConditions ? "var(--gym-warning)" : "var(--gym-success)");"></i>Health Information
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0" style="font-size: 14px;">
                        <dt class="col-sm-3" style="color: var(--gym-text-muted); font-weight: 400;">Medical Conditions</dt>
                        <dd class="col-sm-9 mb-0">
                            @if (Model.Member.HasMedicalConditions)
                            {
                                <span class="badge bg-warning">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Reported
                                </span>
                                @if (!string.IsNullOrEmpty(Model.Member.MedicalNotes))
                                {
                                    <div class="alert alert-warning mt-2 mb-0">
                                        <i class="bi bi-clipboard-pulse me-2"></i>@Model.Member.MedicalNotes
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>None reported
                                </span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i> Member not found.
    </div>
}
