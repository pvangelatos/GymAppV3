@page
@model DetailsModel
@{
    ViewData["Title"] = "Member Details";
}

<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-page="/Staff/Members/Index">Members</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
    </div>
</div>

@if (Model.Member != null)
{
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1>@Model.Member.Firstname @Model.Member.Lastname</h1>
                <a asp-page="/Staff/Members/Edit" asp-route-id="@Model.Member.Id" class="btn btn-primary">
                    Edit Member
                </a>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Member.Firstname @Model.Member.Lastname</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Member.Email</dd>

                        <dt class="col-sm-4">Phone:</dt>
                        <dd class="col-sm-8">@(Model.Member.Phone ?? "Not provided")</dd>

                        <dt class="col-sm-4">Birth Date:</dt>
                        <dd class="col-sm-8">@Model.Member.BirthDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Age:</dt>
                        <dd class="col-sm-8">@((DateTime.Today.Year - Model.Member.BirthDate.Year)) years old</dd>

                        @if (!string.IsNullOrEmpty(Model.Member.UserId))
                        {
                            <dt class="col-sm-4">User ID:</dt>
                            <dd class="col-sm-8"><small class="text-muted">@Model.Member.UserId</small></dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Address</h5>
                </div>
                <div class="card-body">
                    <address>
                        @Model.Member.Address.Street<br />
                        @Model.Member.Address.City, @Model.Member.Address.State @Model.Member.Address.ZipCode<br />
                        @Model.Member.Address.Country
                    </address>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Health Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Medical Conditions:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Member.HasMedicalConditions)
                            {
                                <span class="badge bg-warning">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-success">None reported</span>
                            }
                        </dd>

                        @if (Model.Member.HasMedicalConditions && !string.IsNullOrEmpty(Model.Member.MedicalNotes))
                        {
                            <dt class="col-sm-3">Details:</dt>
                            <dd class="col-sm-9">
                                <div class="alert alert-warning mb-0">
                                    @Model.Member.MedicalNotes
                                </div>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <a asp-page="/Staff/Members/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        Member not found.
    </div>
}
