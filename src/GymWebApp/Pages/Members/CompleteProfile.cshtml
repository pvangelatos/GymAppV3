@page
@model CompleteProfileModel
@{
    ViewData["Title"] = "Complete Your Profile";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Profile", null),
        ("Complete Your Profile", null)
    };
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <partial name="_Breadcrumbs" />
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Please complete your member profile to access all features.</p>
        <hr />

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Firstname" class="form-label"></label>
                    <input asp-for="Input.Firstname" class="form-control" />
                    <span asp-validation-for="Input.Firstname" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Lastname" class="form-label"></label>
                    <input asp-for="Input.Lastname" class="form-control" />
                    <span asp-validation-for="Input.Lastname" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="text" class="form-control" value="@Model.Email" disabled />
                <small class="form-text text-muted">Your registered email address</small>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Phone" class="form-label"></label>
                <input asp-for="Input.Phone" class="form-control" />
                <span asp-validation-for="Input.Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.BirthDate" class="form-label"></label>
                <input asp-for="Input.BirthDate" class="form-control" type="date" />
                <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
            </div>

            <h4 class="mt-4">Address Information</h4>
            <hr />

            <div class="mb-3">
                <label asp-for="Input.Street" class="form-label"></label>
                <input asp-for="Input.Street" class="form-control" />
                <span asp-validation-for="Input.Street" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.City" class="form-label"></label>
                    <input asp-for="Input.City" class="form-control" />
                    <span asp-validation-for="Input.City" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.State" class="form-label"></label>
                    <input asp-for="Input.State" class="form-control" />
                    <span asp-validation-for="Input.State" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.ZipCode" class="form-label"></label>
                    <input asp-for="Input.ZipCode" class="form-control" />
                    <span asp-validation-for="Input.ZipCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Country" class="form-label"></label>
                    <input asp-for="Input.Country" class="form-control" />
                    <span asp-validation-for="Input.Country" class="text-danger"></span>
                </div>
            </div>

            <h4 class="mt-4">Health Information</h4>
            <hr />

            <div class="mb-3 form-check">
                <input asp-for="Input.HasMedicalConditions" class="form-check-input" />
                <label asp-for="Input.HasMedicalConditions" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <label asp-for="Input.MedicalConditionsDescription" class="form-label"></label>
                <textarea asp-for="Input.MedicalConditionsDescription" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.MedicalConditionsDescription" class="text-danger"></span>
                <small class="form-text text-muted">Please describe any medical conditions that may affect your training</small>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Complete Profile</button>
                <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
