@page
@model DashboardModel
@{
    ViewData["Title"] = "My Dashboard";
    ViewData["Breadcrumbs"] = new List<(string Label, string? Url)>
    {
        ("Home", "/"),
        ("Profile", null),
        ("My Dashboard", null)
    };
}

<div class="d-flex justify-content-between align-items-start mb-1">
    <div>
        <h1 class="mb-0">Welcome back, @Model.Member?.Firstname</h1>
        <p class="lead mb-0">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
    </div>
    <a asp-page="/Members/Profile" class="btn btn-outline-primary btn-sm mt-1">
        <i class="bi bi-person-gear me-1"></i> Edit Profile
    </a>
</div>
<hr class="mt-3 mb-4" />

<div class="row">
    <!-- Profile Summary Card -->
    <div class="col-md-4 mb-3">
        <div class="card h-100 card-accent-left">
            <div class="card-header">
                <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                    <i class="bi bi-person-circle me-2" style="color: var(--gym-accent);"></i>Profile Summary
                </h6>
            </div>
            <div class="card-body">
                @if (Model.Member != null)
                {
                    <dl class="row mb-0" style="font-size: 14px;">
                        <dt class="col-5" style="color: var(--gym-text-muted); font-weight: 400;">Name</dt>
                        <dd class="col-7 mb-1">@Model.Member.Firstname @Model.Member.Lastname</dd>

                        <dt class="col-5" style="color: var(--gym-text-muted); font-weight: 400;">Email</dt>
                        <dd class="col-7 mb-1" style="word-break: break-all;">@Model.Member.Email</dd>

                        <dt class="col-5" style="color: var(--gym-text-muted); font-weight: 400;">Phone</dt>
                        <dd class="col-7 mb-1">@(Model.Member.Phone ?? "—")</dd>

                        <dt class="col-5" style="color: var(--gym-text-muted); font-weight: 400;">Birth Date</dt>
                        <dd class="col-7 mb-1">@Model.Member.BirthDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-5" style="color: var(--gym-text-muted); font-weight: 400;">City</dt>
                        <dd class="col-7 mb-0">@Model.Member.Address.City, @Model.Member.Address.State</dd>
                    </dl>
                }
            </div>
            <div class="card-footer">
                <a asp-page="/Members/Profile" class="btn btn-outline-primary btn-sm w-100">View Full Profile</a>
            </div>
        </div>
    </div>

    <!-- Active Bookings Card -->
    <div class="col-md-4 mb-3">
        <div class="card h-100 card-success-left">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                    <i class="bi bi-calendar-check me-2" style="color: var(--gym-success);"></i>Upcoming Bookings
                </h6>
                @if (Model.ActiveBookings.Count > 0)
                {
                    <span class="badge" style="background-color: rgba(143,181,119,0.15); color: var(--gym-success-text);">
                        @Model.ActiveBookings.Count
                    </span>
                }
            </div>
            <div class="card-body">
                @if (Model.ActiveBookings.Count > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var booking in Model.ActiveBookings.Take(5))
                        {
                            <div class="list-group-item px-0 py-2">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <span style="font-size: 14px; font-weight: 500;">@booking.SessionTitle</span>
                                    <span class="badge bg-success ms-2 flex-shrink-0">@booking.Status</span>
                                </div>
                                <small style="color: var(--gym-text-muted);">
                                    <i class="bi bi-clock me-1"></i>
                                    @booking.SessionStartsAt.LocalDateTime.ToString("dd/MM/yyyy 'at' HH:mm")
                                </small>
                            </div>
                        }
                    </div>
                    @if (Model.ActiveBookings.Count > 5)
                    {
                        <p class="small mt-2 mb-0" style="color: var(--gym-text-muted);">
                            +@(Model.ActiveBookings.Count - 5) more bookings
                        </p>
                    }
                }
                else
                {
                    <p style="color: var(--gym-text-muted); font-size: 14px;">No upcoming bookings.</p>
                    <a asp-page="/Classes/Schedule" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Book a Class
                    </a>
                }
            </div>
            <div class="card-footer">
                <a asp-page="/Members/Bookings/Index" class="btn btn-outline-secondary btn-sm w-100">View All Bookings</a>
            </div>
        </div>
    </div>

    <!-- Active Memberships Card -->
    <div class="col-md-4 mb-3">
        <div class="card h-100 card-warning-left">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: var(--gym-text-muted);">
                    <i class="bi bi-card-checklist me-2" style="color: var(--gym-warning);"></i>Active Memberships
                </h6>
                @if (Model.ActiveMemberships.Count > 0)
                {
                    <span class="badge" style="background-color: rgba(217,165,75,0.15); color: var(--gym-warning-text);">
                        @Model.ActiveMemberships.Count
                    </span>
                }
            </div>
            <div class="card-body">
                @if (Model.ActiveMemberships.Count > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var membership in Model.ActiveMemberships)
                        {
                            <div class="list-group-item px-0 py-2">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <span style="font-size: 14px; font-weight: 500;">@membership.PackageName</span>
                                    <span class="badge bg-success ms-2 flex-shrink-0">@membership.Status</span>
                                </div>
                                <small style="color: var(--gym-text-muted);">
                                    <i class="bi bi-calendar-range me-1"></i>
                                    Valid until @membership.EndDate.LocalDateTime.ToString("dd/MM/yyyy")
                                </small>
                                @if (membership.RemainingSessions > 0)
                                {
                                    <div>
                                        <small style="color: var(--gym-text-muted);">
                                            <i class="bi bi-ticket-perforated me-1"></i>
                                            @membership.RemainingSessions sessions remaining
                                        </small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color: var(--gym-text-muted); font-size: 14px;">No active memberships.</p>
                    <a asp-page="/Memberships/Packages" class="btn btn-sm btn-primary">
                        <i class="bi bi-gem me-1"></i> Browse Packages
                    </a>
                }
            </div>
            <div class="card-footer">
                <a asp-page="/Members/Memberships/Index" class="btn btn-outline-secondary btn-sm w-100">View All Memberships</a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mt-2">
    <div class="col-12">
        <p class="small text-uppercase mb-2" style="color: var(--gym-text-muted); letter-spacing: 0.5px; font-size: 11px;">Quick Actions</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Classes/Schedule" class="btn btn-primary btn-sm">
                <i class="bi bi-calendar3 me-1"></i> Class Schedule
            </a>
            <a asp-page="/Classes/Schedule" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Book a Class
            </a>
            <a asp-page="/Memberships/Packages" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-gem me-1"></i> Membership Packages
            </a>
            <a asp-page="/Members/Profile" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-person me-1"></i> Edit Profile
            </a>
        </div>
    </div>
</div>
