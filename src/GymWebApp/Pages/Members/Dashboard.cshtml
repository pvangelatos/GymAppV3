@page
@model DashboardModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="row">
    <div class="col-md-12">
        <h1>Welcome, @Model.Member?.Firstname @Model.Member?.Lastname</h1>
        <hr />
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Profile Summary Card -->
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-circle"></i> Profile Summary</h5>
            </div>
            <div class="card-body">
                @if (Model.Member != null)
                {
                    <p><strong>Name:</strong> @Model.Member.Firstname @Model.Member.Lastname</p>
                    <p><strong>Email:</strong> @Model.Member.Email</p>
                    <p><strong>Phone:</strong> @(Model.Member.Phone ?? "Not provided")</p>
                    <p><strong>Birth Date:</strong> @Model.Member.BirthDate.ToString("dd/MM/yyyy")</p>
                    <p><strong>City:</strong> @Model.Member.Address.City, @Model.Member.Address.State</p>
                }
                <div class="mt-3">
                    <a asp-page="/Members/Profile" class="btn btn-outline-primary btn-sm w-100">View Full Profile</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Bookings Card -->
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Active Bookings</h5>
            </div>
            <div class="card-body">
                @if (Model.ActiveBookings.Count > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var booking in Model.ActiveBookings.Take(5))
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@booking.SessionTitle</h6>
                                    <small>@booking.Status</small>
                                </div>
                                <small class="text-muted">
                                    @booking.SessionStartsAt.LocalDateTime.ToString("dd/MM/yyyy 'at' hh:mm")
                                </small>
                            </div>
                        }
                    </div>
                    @if (Model.ActiveBookings.Count > 5)
                    {
                        <p class="text-muted small mt-2">+@(Model.ActiveBookings.Count - 5) more bookings...</p>
                    }
                }
                else
                {
                    <p class="text-muted">No upcoming bookings</p>
                    <a asp-page="/Classes/Schedule" class="btn btn-success btn-sm">Book a Class</a>
                }
                <div class="mt-3">
                    <a asp-page="/Members/Bookings/Index" class="btn btn-outline-success btn-sm w-100">View All Bookings</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Memberships Card -->
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-card-checklist"></i> Active Memberships</h5>
            </div>
            <div class="card-body">
                @if (Model.ActiveMemberships.Count > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var membership in Model.ActiveMemberships)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@membership.PackageName</h6>
                                    <span class="badge bg-success">@membership.Status</span>
                                </div>
                                <small class="text-muted">
                                    Valid until @membership.EndDate.LocalDateTime.ToString("dd/MM/yyyy")
                                </small>
                                @if (membership.RemainingSessions > 0)
                                {
                                    <div class="mt-1">
                                        <small><strong>Sessions:</strong> @membership.RemainingSessions remaining</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No active memberships</p>
                    <a asp-page="/Memberships/Packages" class="btn btn-warning btn-sm">Purchase Membership</a>
                }
                <div class="mt-3">
                    <a asp-page="/Members/Memberships/Index" class="btn btn-outline-warning btn-sm w-100">View All Memberships</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-page="/Classes/Schedule" class="btn btn-primary w-100">
                            <i class="bi bi-calendar3"></i> View Class Schedule
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-page="/Classes/Schedule" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Book a Class
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-page="/Memberships/Packages" class="btn btn-warning w-100">
                            <i class="bi bi-credit-card"></i> View Packages
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-page="/Members/Profile" class="btn btn-info w-100">
                            <i class="bi bi-person"></i> Edit Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
